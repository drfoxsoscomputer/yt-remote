# YT-Remote: copia este archivo a ".env" y completa con tus datos reales.
# El archivo .env NO se sube a GitHub (esta en .gitignore). Nunca pongas
# tu token real en ningun archivo que se suba al repositorio.

# Token del bot (lo da @BotFather al crear el bot).
TELEGRAM_TOKEN=TU_TOKEN_AQUI

# Tu ID de Telegram. Se consigue hablando con @userinfobot: te lo muestra
# como "Id: 123456789". El dueno queda con rol admin automaticamente.
OWNER_ID=

# ID del grupo donde el bot va a funcionar (opcional).
# Si lo dejas vacio, el bot responde en cualquier chat. Para restringirlo
# a un solo grupo: crea el grupo, agrega el bot, mandale /start y fijate
# el chat_id que imprime en la consola al correr start.bat; pegalo aca.
ALLOWED_CHAT_ID=
