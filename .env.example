# YT-Remote - plantilla de configuración
# Copia este archivo como .env y completa tus datos reales.
# El .env NO se sube a GitHub (está en el .gitignore).

# TOKEN del bot: lo crea @BotFather con el comando /newbot
TELEGRAM_TOKEN=

# Tu ID numérico de Telegram: se obtiene con @userinfobot
OWNER_ID=

# Opcional: ID del chat/grupo donde el bot quedará habilitado.
# Por defecto se configura automáticamente con el primer /start del dueño.
ALLOWED_CHAT_ID=