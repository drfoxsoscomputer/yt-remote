# YT-Remote - plantilla de configuracion
# Copia este archivo como .env y completa con tus datos reales.
# El .env NO se sube a GitHub (esta en .gitignore).

# Token del bot: lo crea @BotFather con el comando /newbot
TELEGRAM_TOKEN=

# Tu ID numerico de Telegram: se obtiene con @userinfobot
OWNER_ID=

# Opcional: ID del chat o grupo donde el bot quedara habilitado.
# Si lo dejas vacio, se configura solo con el primer /start del dueno.
ALLOWED_CHAT_ID=
