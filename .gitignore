# Data generados en tiempo de ejecucion
data/roles.json
data/*.json

# Cache Python
__pycache__/
*.py[cod]

# Logs
*.log

# Herramientas de desarrollo (skill registry, indice de codigo)
.atl/
.codegraph/

# Config real (la plantilla publica es .env.example)
.env
.env.example.tmp
*.swp

# Binarios no usados (mini app revertida)
bin/

# El launcher sirve static/ (css, js, img, logo) via Flask: se versiona

# Distribucion portable (se sube a GitHub release como asset)
yt-remote-*.zip

# pytest (instalado solo para testing local, no se sube)
runtime/python/Scripts/py.test.exe
runtime/python/Scripts/pytest.exe
runtime/python/Lib/site-packages/pytest/
runtime/python/Lib/site-packages/pytest_asyncio/
