{
  "_comment": "Fuente unica de reglas para armar el ZIP portable. La consume release_zip.py (modulo compartido por build_exe.py y build.py). No duplicar estas reglas en otro archivo.",
  "version": "1.1.3",
  "zip_name_template": "yt-remote-{version}-portable.zip",
  "exe_name": "ytremote.exe",
  "include_top_files": [
    "ytremote.exe",
    "config.json",
    "README.md",
    "GUIA.txt"
  ],
  "exclude_top_files": [
    "ytremote.bat",
    "ESTADO.md",
    "build_exe.py",
    "requirements.txt",
    "release_rules.json",
    "yt-remote-v0.4.0-portable.zip",
    "yt-remote-v0.5.0-portable.zip",
    ".env.example",
    ".env",
    "launcher.spec",
    "pytest.ini",
    "gitleaks.toml"
  ],
  "exclude_top_dirs": [
    ".atl",
    ".git",
    ".githooks",
    ".pytest_cache",
    "bin",
    "build",
    "dist",
    "scripts"
  ],
  "folders": {
"src": {
   "allow_all": true,
   "_comment": "allow_all: se empaqueta todo src/*.py del arbol. La lista escrita a mano se quedo vieja y el ZIP salio roto (sin store.py ni los modulos nuevos).",
   "exclude_files": [
    "demo_roles.py",
    "launcher.py",
    "testkit.py"
   ],
   "exclude_globs": [
    "test_*.py"
   ]
  },
    "data": {
      "allowed_files": [
        ".gitkeep"
      ]
    },
    "runtime": {
      "mpv": "include_all",
      "python_core": "include_all",
      "site_packages_allowlist": [
        "anyio",
        "apscheduler",
        "certifi",
        "h11",
        "httpcore",
        "httpx",
        "idna",
        "python_telegram_bot",
        "sniffio",
        "telegram",
        "typing_extensions",
        "tzdata",
        "tzlocal",
        "yt_dlp"
      ],
      "site_packages_extra_loose_files": [
        "typing_extensions.py"
      ],
      "always_exclude_globs": [
        "**/__pycache__/**",
        "**/*.pyc",
        "**/*.pyo"
      ]
    }
  }
}